{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openwaymark:schema:manifest:0.1",
  "title": "OpenWaymark manifest, format version 0.1 (draft)",
  "description": "Structure of an OpenWaymark manifest (study.yaml) after YAML parsing. Copyright 2026 Automate the Cloud Inc. Licensed under the Apache License 2.0. This schema checks structure only. The specification (spec/openwaymark.md) also requires checks no schema can express, including: choice references in correct_answers (OWM-Q-004); item ID uniqueness across questions and flashcards (OWM-ID-002); choice ID uniqueness within a question (OWM-ID-003); selection_count equal to the number of correct answers (OWM-Q-006); the total of 10,000 items (section 11); UTF-8 byte limits on text (OWM-CONT-001); the YAML profile, including the prohibition of floating-point numbers, which a JSON data model cannot distinguish from integers (section 4); the Markdown profile (section 9.3); assets and archive structure (sections 3 and 10); and full BCP 47 and SPDX syntax.",
  "$comment": "The $id is a placeholder URN until the project has a permanent domain.",
  "type": "object",
  "required": ["format_version", "id", "title", "version", "language"],
  "anyOf": [
    {
      "required": ["questions"]
    },
    {
      "required": ["flashcards"]
    }
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "description": "OWM-VER-001",
      "const": "0.1"
    },
    "id": {
      "description": "OWM-COL-004: canonical lowercase UUID, not nil or max.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "enum": ["00000000-0000-0000-0000-000000000000", "ffffffff-ffff-ffff-ffff-ffffffffffff"]
      }
    },
    "title": {
      "$ref": "#/$defs/plainText200"
    },
    "version": {
      "description": "OWM-COL-006: Semantic Versioning 2.0.0.",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "description": {
      "$ref": "#/$defs/markdown"
    },
    "subject": {
      "$ref": "#/$defs/plainText200"
    },
    "tags": {
      "$ref": "#/$defs/tags",
      "maxItems": 64,
      "type": "array"
    },
    "authors": {
      "description": "OWM-COL-009",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/author"
      }
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "created": {
      "$ref": "#/$defs/date"
    },
    "updated": {
      "$ref": "#/$defs/date"
    },
    "sources": {
      "description": "OWM-ITEM-006",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "practice_defaults": {
      "description": "OWM-COL-014",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passing_percentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "requires": {
      "description": "OWM-VER-005",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "anyOf": [
          {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          {
            "$ref": "#/$defs/namespace"
          }
        ]
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    },
    "questions": {
      "description": "OWM-COL-002",
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "flashcards": {
      "description": "OWM-COL-002",
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/flashcard"
      }
    }
  },
  "$defs": {
    "nonblank": {
      "description": "OWM-YAML-010: contains a character other than white space.",
      "type": "string",
      "pattern": "\\S"
    },
    "plainText200": {
      "$ref": "#/$defs/nonblank",
      "maxLength": 200,
      "type": "string"
    },
    "markdown": {
      "description": "Text in the Markdown profile (section 9.3). The limit is 65,536 UTF-8 bytes; maxLength counts code points, so it is a necessary bound only.",
      "$ref": "#/$defs/nonblank",
      "maxLength": 65536,
      "type": "string"
    },
    "date": {
      "description": "OWM-COL-013: RFC 3339 full-date.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "httpsUrl": {
      "description": "OWM-LINK-001: absolute https URL with a host, at most 2,048 characters.",
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^\\s/?#@]+(?:[/?#]\\S*)?$",
      "format": "uri"
    },
    "itemId": {
      "description": "OWM-ID-001",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "tag": {
      "description": "OWM-ITEM-004",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tag"
      }
    },
    "namespace": {
      "description": "OWM-EXT-001: lowercase reverse domain name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
    },
    "extensions": {
      "description": "OWM-EXT-001",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/namespace"
      }
    },
    "assetPath": {
      "description": "OWM-IMG-004 and OWM-IMG-006: assets/ followed by 1 to 8 segments, ending in a permitted lowercase extension.",
      "type": "string",
      "maxLength": 255,
      "pattern": "^assets/(?:[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}/){0,7}[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}\\.(?:png|jpg|jpeg|webp)$"
    },
    "image": {
      "description": "OWM-IMG-001 to OWM-IMG-003",
      "type": "object",
      "required": ["src", "alt"],
      "additionalProperties": false,
      "properties": {
        "src": {
          "$ref": "#/$defs/assetPath"
        },
        "alt": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^$|\\S"
        },
        "credit": {
          "$ref": "#/$defs/nonblank",
          "maxLength": 500,
          "type": "string"
        },
        "credit_url": {
          "$ref": "#/$defs/httpsUrl"
        }
      },
      "dependentRequired": {
        "credit_url": ["credit"]
      }
    },
    "content": {
      "description": "OWM-CONT-001",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["text"]
        },
        {
          "required": ["image"]
        }
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/markdown"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "language": {
          "description": "OWM-CONT-003: language of this part, when it differs from the collection's.",
          "$ref": "#/$defs/language"
        }
      }
    },
    "reference": {
      "description": "OWM-ITEM-006",
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/nonblank",
          "maxLength": 500,
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/nonblank",
          "maxLength": 500,
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/plainText200"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "license": {
      "description": "OWM-COL-010",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "spdx": {
          "$ref": "#/$defs/nonblank",
          "maxLength": 1000,
          "type": "string"
        },
        "statement": {
          "$ref": "#/$defs/nonblank",
          "maxLength": 2000,
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "revision": {
      "description": "OWM-ITEM-001",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "choice": {
      "description": "OWM-Q-008",
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["text"]
        },
        {
          "required": ["image"]
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "text": {
          "$ref": "#/$defs/markdown"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "explanation": {
          "$ref": "#/$defs/content"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        },
        "language": {
          "description": "OWM-CONT-003: language of this part, when it differs from the collection's.",
          "$ref": "#/$defs/language"
        }
      }
    },
    "question": {
      "description": "Section 7.3",
      "type": "object",
      "required": ["id", "type", "selection", "prompt", "choices", "correct_answers"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "type": {
          "const": "multiple_choice"
        },
        "selection": {
          "enum": ["single", "multiple"]
        },
        "prompt": {
          "$ref": "#/$defs/content"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 26,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "correct_answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 26,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/itemId"
          }
        },
        "selection_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26
        },
        "shuffle_choices": {
          "type": "boolean"
        },
        "explanation": {
          "$ref": "#/$defs/content"
        },
        "hint": {
          "$ref": "#/$defs/content"
        },
        "tags": {
          "$ref": "#/$defs/tags",
          "maxItems": 32,
          "type": "array"
        },
        "references": {
          "$ref": "#/$defs/references"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "if": {
        "properties": {
          "selection": {
            "const": "single"
          }
        }
      },
      "then": {
        "description": "OWM-Q-005",
        "properties": {
          "correct_answers": {
            "type": "array",
            "maxItems": 1
          }
        },
        "not": {
          "required": ["selection_count"]
        }
      }
    },
    "flashcard": {
      "description": "Section 7.4",
      "type": "object",
      "required": ["id", "front", "back"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "front": {
          "$ref": "#/$defs/content"
        },
        "back": {
          "$ref": "#/$defs/content"
        },
        "hint": {
          "$ref": "#/$defs/content"
        },
        "tags": {
          "$ref": "#/$defs/tags",
          "maxItems": 32,
          "type": "array"
        },
        "references": {
          "$ref": "#/$defs/references"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "language": {
      "description": "OWM-COL-008: BCP 47 language tag. This pattern approximates well-formedness; validators apply the full RFC 5646 grammar.",
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    }
  }
}
